<%- include('../partials/header') %>

<p><a href="/books">&larr; Back to catalogue</a></p>

<div class="card book-detail">
  <div class="book-detail-main">
    <span class="tag"><%= book.category || 'Uncategorised' %></span>
    <h1><%= book.title %></h1>
    <p class="lead">by <%= book.author %></p>
    <% if (book.description) { %><p><%= book.description %></p><% } %>
    <table class="table kv">
      <tr><th>ISBN</th><td><code><%= book.isbn %></code></td></tr>
      <tr><th>Publisher</th><td><%= book.publisher || '-' %></td></tr>
      <tr><th>Published</th><td><%= book.published_year || '-' %></td></tr>
      <tr><th>Availability</th>
        <td><span class="availability <%= book.available_copies > 0 ? 'ok' : 'none' %>"><%= book.available_copies %> of <%= book.total_copies %> copies available</span></td></tr>
    </table>
  </div>

  <aside class="book-actions">
    <% if (!currentUser) { %>
      <a class="btn btn-block" href="/login?next=/books/<%= book.id %>">Log in to borrow</a>
    <% } else if (myLoan) { %>
      <p class="alert alert-info">You have this book. Due on <strong><%= fmtDate(myLoan.due_date) %></strong>.</p>
      <form method="post" action="/loans/<%= myLoan.id %>/return"><button class="btn btn-block">Return book</button></form>
    <% } else if (book.available_copies > 0) { %>
      <form method="post" action="/loans">
        <input type="hidden" name="book_id" value="<%= book.id %>">
        <button class="btn btn-block">Borrow this book</button>
      </form>
      <p class="muted small">Loan period is 14 days. Late returns are fined Rs. 10/day.</p>
    <% } else { %>
      <button class="btn btn-block" disabled>Currently unavailable</button>
    <% } %>

    <% if (currentUser && currentUser.role === 'admin') { %>
      <hr>
      <a class="btn btn-ghost btn-block" href="/books/<%= book.id %>/edit">Edit book</a>
      <form method="post" action="/books/<%= book.id %>/delete" class="confirm-delete">
        <button class="btn btn-danger btn-block">Delete book</button>
      </form>
    <% } %>
  </aside>
</div>

<% if (currentUser && currentUser.role === 'admin') { %>
  <div class="card">
    <h2>Recent loan history</h2>
    <% if (!history.length) { %>
      <p class="muted">This book has not been borrowed yet.</p>
    <% } else { %>
      <table class="table">
        <thead><tr><th>Member</th><th>Issued</th><th>Due</th><th>Returned</th><th>Fine</th></tr></thead>
        <tbody>
          <% history.forEach(function (l) { %>
            <tr><td><%= l.member %></td><td><%= fmtDate(l.issued_at) %></td><td><%= fmtDate(l.due_date) %></td>
              <td><%= l.returned_at ? fmtDate(l.returned_at) : 'On loan' %></td><td>Rs. <%= Number(l.fine_amount).toFixed(0) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
<% } %>

<%- include('../partials/footer') %>
