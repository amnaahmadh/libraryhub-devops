<%- include('../partials/header') %>

<% const editing = Boolean(book.id); %>
<p><a href="<%= editing ? '/books/' + book.id : '/books' %>">&larr; Cancel</a></p>

<div class="card narrow">
  <h1><%= editing ? 'Edit book' : 'Add a new book' %></h1>
  <%- include('../partials/errors') %>
  <form method="post" action="<%= editing ? '/books/' + book.id : '/books' %>" class="form">
    <label>Title <input type="text" name="title" value="<%= book.title || '' %>" maxlength="200" required></label>
    <label>Author <input type="text" name="author" value="<%= book.author || '' %>" maxlength="150" required></label>
    <div class="form-row">
      <label>ISBN <input type="text" name="isbn" value="<%= book.isbn || '' %>" placeholder="10 or 13 digits" required></label>
      <label>Category
        <select name="category_id">
          <option value="">Uncategorised</option>
          <% categories.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= book.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </label>
    </div>
    <div class="form-row">
      <label>Publisher <input type="text" name="publisher" value="<%= book.publisher || '' %>" maxlength="150"></label>
      <label>Published year <input type="number" name="published_year" value="<%= book.published_year || '' %>" min="1450" max="<%= new Date().getFullYear() %>"></label>
      <label>Total copies <input type="number" name="total_copies" value="<%= book.total_copies %>" min="1" max="1000" required></label>
    </div>
    <label>Description <textarea name="description" rows="4"><%= book.description || '' %></textarea></label>
    <button class="btn"><%= editing ? 'Save changes' : 'Add book' %></button>
  </form>
</div>

<%- include('../partials/footer') %>
