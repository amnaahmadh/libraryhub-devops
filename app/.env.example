# Only needed to run the app directly with `npm start` (outside Docker).
# With Docker Compose these values come from the compose file and ../.env instead.
PORT=3000
NODE_ENV=production
DEPLOY_TARGET=Local

DB_HOST=localhost
DB_PORT=3306
DB_USER=library_app
DB_PASSWORD=change-me
DB_NAME=library_db

SESSION_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@library.com
ADMIN_PASSWORD=Admin@123
