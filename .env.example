# Secrets for both compose files. Never commit the real values.
#   Part I : copy to .env next to docker-compose.yml on the EC2 instance
#   Part II: upload a file with the same keys to Jenkins as the Secret file credential "libraryhub-ci-env"
# Letters and digits only, e.g. generated with:  openssl rand -hex 16
# DB_READONLY_PASSWORD is given to the evaluator, so use the same value in both files.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
DB_READONLY_PASSWORD=
SESSION_SECRET=
